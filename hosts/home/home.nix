# home-manager for brian on home: the portable half of the usual config
# (home/core -- shell, editor, claude/codex/copilot, git) plus summer's
# rootless podman containers and the tailnet sidecars.
#
# No home/desktop: this box is headless.
#
# Containers are quadlets generated by home-manager's services.podman, so each
# one is a user unit named podman-<name>.service:
#
#   systemctl --user status podman-summer-app
#   journalctl --user -u podman-summer-surrealdb
#
# Unattended: every container sets autoStart, and linger (configuration.nix)
# starts the user manager at boot, so all of this comes up without a login.
#
# Volume data was carried over from Fedora with `podman volume import`; the
# volume names below are what ./MIGRATION.md imports into.
{ pkgs, ... }:

let
  # The tailscale/tailscale container's serve config. `${TS_CERT_DOMAIN}` is
  # expanded by containerboot, not by Nix. Bind-mounted as a file straight
  # from the store: a symlink into /nix/store would dangle inside the container.
  serveConfig =
    name: config:
    pkgs.writeText "tailscale-serve-${name}.json" (builtins.toJSON config);

  httpsTo = target: {
    TCP."443".HTTPS = true;
    Web."\${TS_CERT_DOMAIN}:443".Handlers."/".Proxy = target;
  };

  # One tailnet node per service, in userspace mode (no tun, no privileges).
  # Its state volume carries the node key, so the node keeps its name and IP.
  # TS_AUTHKEY in authkey.env is only read if that state is ever lost.
  sidecar =
    {
      hostname,
      serve,
      network,
      extraEnv ? { },
      after ? [ ],
    }:
    {
      image = "docker.io/tailscale/tailscale:stable";
      autoStart = true;
      inherit network;
      environment = {
        TS_HOSTNAME = hostname;
        TS_USERSPACE = "true";
        TS_STATE_DIR = "/var/lib/tailscale";
        TS_SERVE_CONFIG = "/config/serve.json";
      } // extraEnv;
      environmentFile = [ "%h/.config/tailscale-sidecar/authkey.env" ];
      volumes = [
        "tailscale-${hostname}-state.volume:/var/lib/tailscale"
        "${serveConfig hostname serve}:/config/serve.json:ro"
      ];
      extraConfig.Unit = {
        Requires = after;
        After = after;
        BindsTo = after;
      };
    };
in
{
  imports = [ ../../home/core ];

  home = {
    username = "brian";
    homeDirectory = "/home/brian";
    stateVersion = "26.05";
  };

  programs.home-manager.enable = true;

  services.podman = {
    enable = true;

    networks.summer = { };

    volumes = {
      summer-data = { };
      tailscale-summer-state = { };
      tailscale-code-state = { };
    };

    containers = {
      # --- summer: https://summer.tail42107.ts.net -------------------------

      summer-surrealdb = {
        # Pinned to what Fedora ran (3.1.2): surrealkv's on-disk format is
        # what the imported volume holds. Bump deliberately, after a backup.
        image = "docker.io/surrealdb/surrealdb:v3.1.2";
        autoStart = true;
        exec = "start --log info --bind 0.0.0.0:8000 --unauthenticated --allow-all surrealkv:/data";
        network = "summer.network";
        networkAlias = [ "summer-surrealdb" ];
        volumes = [ "summer-data.volume:/data:U" ];
      };

      # Built from ~/code/summer by `summer-rebuild` below, not by a quadlet
      # .build unit: a boot-time build would make summer's availability after
      # a power cut depend on the network and on npm.
      summer-app = {
        image = "localhost/summer-app:latest";
        autoStart = true;
        network = "summer.network";
        environment = {
          NODE_ENV = "production";
          SURREALDB_URL = "http://summer-surrealdb:8000";
          SURREALDB_NAMESPACE = "summer";
          SURREALDB_DATABASE = "summer";
        };
        # Loopback only. (On Fedora it was 3000:3000 -- open to the LAN.)
        ports = [ "127.0.0.1:3000:3000" ];
        extraConfig.Unit = {
          Requires = [ "podman-summer-surrealdb.service" ];
          After = [ "podman-summer-surrealdb.service" ];
        };
      };

      # Shares summer-app's netns, so it reaches the app at 127.0.0.1:3000.
      tailscale-summer = sidecar {
        hostname = "summer";
        network = "container:summer-app";
        serve = httpsTo "http://127.0.0.1:3000";
        after = [ "podman-summer-app.service" ];
      };

      # --- Forgejo: https://code.tail42107.ts.net, ssh on :2222 -------------
      #
      # Forgejo is a native NixOS service (configuration.nix), so this sidecar
      # shares the HOST's netns instead of a container's, and reaches Forgejo
      # on the host's loopback.
      #
      # `code`, not `gitea` or `forgejo`: a name for the role, so it can stay
      # put if the software or the box changes again. The node itself is the
      # old `gitea` one (its state volume was imported into
      # tailscale-code-state), renamed by TS_HOSTNAME -- no new auth key.
      tailscale-code = sidecar {
        hostname = "code";
        network = "host";
        serve = (httpsTo "http://127.0.0.1:3300") // {
          TCP = {
            "443".HTTPS = true;
            "2222".TCPForward = "127.0.0.1:2222";
          };
        };
        # In the host netns this tailscaled would otherwise contend with the
        # host's own for UDP 41641.
        extraEnv.TS_TAILSCALED_EXTRA_ARGS = "--port=41642";
      };
    };
  };

  home.packages = [
    # Rebuild summer's image from the checkout and restart it onto the new one.
    (pkgs.writeShellApplication {
      name = "summer-rebuild";
      runtimeInputs = [ pkgs.podman ];
      text = ''
        podman build -t localhost/summer-app:latest "$HOME/code/summer"
        systemctl --user restart podman-summer-app.service
      '';
    })
  ];
}
