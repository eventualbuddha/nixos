# Template for /etc/vmguard/secrets.env  (chmod 600, owned by vmguard user)
# Fill in the real value, then save as secrets.env in the staging dir.
# NEVER commit with a real value; NEVER place this secret inside the guest.
#
# Three credentials are held host-side, all injected by the addon and none ever
# placed in the guest. Under design "B" the Anthropic credential is a Pro/Max
# subscription token that lives IN THE GUEST (see guest-setup.sh), so there is no
# Anthropic secret here.
#
# GH_PAT is the one GitHub token the guest's git, gh and API traffic all rides on.
# Either kind works: the hosts deployed so far run a CLASSIC `ghp_` token, which reaches
# every repo you can (the addon, not the token, is what limits writes to WRITE_ORGS). A
# fine-grained `github_pat_` token scoped to the repos you actually use would narrow that.
GH_PAT=ghp_or_github_pat_REPLACE_ME

# CircleCI personal API token — OPTIONAL. Used for exactly one thing: injecting auth on
# POST /api/v2/workflow/{id}/rerun so the guest can retry failed CI jobs (NOTES 43).
# CircleCI reads need no token (vxsuite is public) and get none.
#
# DELETE THIS LINE if you don't want that: the gate starts and runs fine without it, and
# reruns are simply denied ("no CIRCLE_TOKEN configured host-side") until it's set.
#
# It must be a PERSONAL token — CircleCI does not accept project-scoped tokens on API v2 —
# so it is account-wide by nature. The addon, not the token, is what narrows it to one
# endpoint in one set of orgs. Mint at: circleci.com → User Settings → Personal API Tokens.
CIRCLE_TOKEN=CCIPAT_REPLACE_ME

# GitHub Copilot token — OPTIONAL. Used only for Copilot CLI (NOTES 65): swapped in for the
# guest's placeholder on api.individual.githubcopilot.com, api.githubcopilot.com and
# api.github.com/copilot_internal/*. Without it those are denied and the gate runs as before.
#
# Must be a FINE-GRAINED token (Copilot refuses classic ones): resource owner = your personal
# account, repository access = "Public repositories", no repository permissions, account
# permission "Copilot Requests" and nothing else. It cannot write to GitHub on its own.
# Mint at: github.com → Settings → Developer settings → Fine-grained tokens.
COPILOT_TOKEN=github_pat_REPLACE_ME
